# pangpang project environment.  Every toolchain, cache, temp file and
# piece of state is pinned under this directory.
PP_HOME=$(pwd -P)
export PP_HOME
export PP_TOOLS="$PP_HOME/.tools"
export PP_VAR="$PP_HOME/var"
export MAMBA_ROOT_PREFIX="$PP_TOOLS/mamba"
PP_ENV="$MAMBA_ROOT_PREFIX/envs/pangpang"
export PP_ENV_LOADED=1

if [ ! -x "$PP_ENV/bin/node" ]; then
  log_error "pangpang toolchain missing: run ./bootstrap.sh"
fi

PATH_add "$PP_ENV/bin"
PATH_add "$PP_TOOLS/bin"
PATH_add "$PP_HOME/node_modules/.bin"
PATH_add "$PP_HOME/bin"

# Caches and temp files.  /tmp is on the system volume too.
# XDG_CONFIG_HOME and XDG_DATA_HOME stay untouched: direnv keeps its allow
# list there.
export TMPDIR="$PP_VAR/tmp"
export XDG_CACHE_HOME="$PP_VAR/cache"
export XDG_STATE_HOME="$PP_VAR/state"
export npm_config_cache="$PP_VAR/cache/npm"
export UV_CACHE_DIR="$PP_VAR/cache/uv"
export PIP_CACHE_DIR="$PP_VAR/cache/pip"
export TMUX_TMPDIR="$PP_VAR/run"
# Use the environment terminfo database.
export TERMINFO="$PP_ENV/share/terminfo"

# Prefer IPv4 when networking requires it.
export NODE_OPTIONS="--dns-result-order=ipv4first --no-network-family-autoselection"

# caveman (token compression proxy): binaries, run state and the store of
# compressed originals are rebuildable, so they live in var/; the proxy
# config is tracked.
export CAVEMAN_HOME="$PP_VAR/caveman"
export CAVEMAN_CONFIG="$PP_HOME/agent/caveman.yaml"
export CAVE_GATEWAY_URL="http://127.0.0.1:8787"
# The agent fulfils recovery itself through the caveman_retrieve tool
# (src/caveman), so the proxy publishes recovery_via_mcp and routing opens.
export CAVEMAN_RECOVERY=mcp
# Hooks run the Go binary (a few ms) instead of the Node CLI; recovery uses caveman-mcp.
export CAVEMAN_PI_HOOK_CMD="[\"$CAVEMAN_HOME/bin/caveman-proxy\"]"
export CAVEMAN_MCP_BIN="$CAVEMAN_HOME/bin/caveman-mcp"
export GOPATH="$PP_VAR/cache/go"
export GOMODCACHE="$PP_VAR/cache/go/mod"
export GOCACHE="$PP_VAR/cache/go/build"
export GOTOOLCHAIN=local
export GOTELEMETRY=off

# pi: config, skills and extensions are tracked in agent/; sessions are state.
export PI_CODING_AGENT_DIR="$PP_HOME/agent"
export PI_CODING_AGENT_SESSION_DIR="$PP_VAR/sessions"
export PI_SKIP_VERSION_CHECK=1
# Model pool (src/pool): cooldown state and debug log are runtime state.
export PI_MODEL_ALIAS_STATE_DIR="$PP_VAR/state/model-alias"
export PI_TELEMETRY=0

dotenv_if_exists .env
